# =============================================================================
# Orchestrator image: schema bootstrap, task planner, monitor, reaper, reducer.
#
# Pure Python — no Unity, no engine, and deliberately no psql either. ~120 MB
# against the worker's ~400 MB, which matters because the lease-reaper CronJob pulls
# this every minute for the duration of a run.
#
#   docker build -f distributed/docker/Dockerfile.orchestrator \
#       -t sunlightcity/orchestrator:v2 .
# (build context = repo root, so distributed/ is visible)
#
# WHY NO postgresql-client
# ------------------------
# Applying six SQL files across eleven instances is the obvious job for psql, and
# apply_schema.py does it through psycopg2 instead. That is not a preference: the
# script has to know WHICH files go to WHICH role, resolve shard endpoints from the
# coordinator's own meo_shards registry, and strip psql backslash meta-commands that
# are invalid over a normal connection. A shell loop around psql would need the
# endpoint list passed in — which is exactly the duplication the registry exists to
# remove — and would silently apply a shard file to the coordinator if the loop
# bounds were wrong.
#
# It also keeps the image free of a client whose libpq could drift from psycopg2's.
# =============================================================================

FROM python:3.11-slim-bookworm

LABEL org.opencontainers.image.title="SunlightCity orchestrator" \
      org.opencontainers.image.description="Plans, monitors, reaps and finalises distributed exposure runs"

ENV PYTHONUNBUFFERED=1 \
    # No .pyc files: the container is immutable and readOnlyRootFilesystem would
    # make the write fail anyway.
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# psycopg2-binary ships prebuilt wheels with libpq statically linked, so we need
# no build toolchain and no libpq-dev at runtime. That is the difference between
# a ~120 MB image and a ~400 MB one, and it removes gcc from the attack surface.
# (Using psycopg2 from source would require build-essential + libpq-dev here.)
COPY distributed/orchestrator/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt && rm /tmp/requirements.txt

WORKDIR /app

COPY distributed/orchestrator/*.py /app/

# The SQL ships too: apply_schema.py applies 01-04 and 06 by path, and
# reduce_finalize.py runs 05 against each shard. Both default --sql-dir to /app/db
# via SUNLIT_SQL_DIR below.
COPY distributed/db/*.sql /app/db/

RUN set -eux; \
    groupadd --gid 10002 orch; \
    useradd --uid 10002 --gid 10002 --no-create-home --shell /usr/sbin/nologin orch; \
    chown -R orch:orch /app; \
    # Fail the IMAGE BUILD on a syntax error rather than a pod at 3am. Cheap, and it
    # has caught a bad edit more than once.
    python -m py_compile /app/*.py; \
    # Assert the SQL actually made it in. A missing file here fails the schema Job
    # with FileNotFoundError after it has already touched the coordinator.
    test -f /app/db/01_cluster_topology.sql; \
    test -f /app/db/02_work_queue.sql; \
    test -f /app/db/03_shard_schema.sql; \
    test -f /app/db/04_bulk_load_tuning.sql; \
    test -f /app/db/05_post_load_indexes.sql; \
    test -f /app/db/06_serving_federation.sql; \
    echo "SQL shipped:"; ls -1 /app/db/

USER orch

# --sql-dir defaults to ../db relative to the script, which is /db inside the image
# rather than /app/db. Setting SUNLIT_SQL_DIR here means callers need not pass it,
# and the k8s Jobs pass it anyway so the path is visible in the manifest.
ENV SUNLIT_SQL_DIR=/app/db

# No ENTRYPOINT: this image hosts four distinct commands and the Job/CronJob
# specifies which. Baking one in would mean overriding it everywhere.
CMD ["python", "-c", "print('Specify a command: apply_schema.py | plan_tasks.py | monitor.py | reduce_finalize.py | pg_tune.py | model.py | cluster.py')"]
